+
+    private var item: PeerInfoScreenGroupRulesItem?
+    private let introduces: Bool
+    private var didIntroduce = false
+
+    init(introduces: Bool) {
+        self.introduces = introduces
+        var bringToFrontForHighlightImpl: (() -> Void)?
