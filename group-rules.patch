+// MARK: - Layer animations
+
+private var rulesBlurCount = 0
+
+/// A layer coming into focus: from `radius` points of blur to sharp.
+public func rulesAnimateBlurIn(_ layer: CALayer, radius: CGFloat, duration: Double, delay: Double = 0.0) {
+    // Not on a layer that has filters of its own.
+    guard layer.filters == nil || layer.value(forKey: "rulesBlur") != nil, let blur = CALayer.blur() else {
+        return
+    }
+    blur.setValue(0.0 as NSNumber, forKey: "inputRadius")
+    layer.filters = [blur]
+    layer.setValue(true, forKey: "rulesBlur")
+    rulesBlurCount += 1
+    let token = rulesBlurCount
+    layer.setValue(token, forKey: "rulesBlurToken")
+    layer.animate(from: radius as NSNumber, to: 0.0 as NSNumber, keyPath: "filters.gaussianBlur.inputRadius", timingFunction: CAMediaTimingFunctionName.easeOut.rawValue, duration: duration, delay: delay, removeOnCompletion: true)
+    // The filter goes as soon as the blur has ended: left on a layer, even at no blur, it renders the layer soft (at a
+    // lower resolution) and costs a pass on every frame. A later blur of the same layer takes over.
+    DispatchQueue.main.asyncAfter(deadline: .now() + delay + duration + 0.05, execute: { [weak layer] in
+        guard let layer, (layer.value(forKey: "rulesBlurToken") as? Int) == token else {
+            return
+        }
+        layer.removeAnimation(forKey: "filters.gaussianBlur.inputRadius")
+        layer.filters = nil
+        layer.setValue(nil, forKey: "rulesBlur")
+        layer.setValue(nil, forKey: "rulesBlurToken")
+    })
+}
+
+/// An element rising into place: up from below, out of a blur, a little larger first.
+public func rulesAnimateRiseIn(_ layer: CALayer, delay: Double, offset: CGFloat = 18.0, scale: CGFloat = 0.94, blur: CGFloat = 8.0) {
+    layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.28, delay: delay)
+    layer.animateSpring(from: NSValue(cgPoint: CGPoint(x: 0.0, y: offset)), to: NSValue(cgPoint: CGPoint()), keyPath: "position", duration: 0.7, delay: delay, damping: 88.0, additive: true)
+    if scale != 1.0 {
+        layer.animateSpring(from: scale as NSNumber, to: 1.0 as NSNumber, keyPath: "transform.scale", duration: 0.7, delay: delay, damping: 88.0)
+    }
+    if blur > 0.0 {
+        rulesAnimateBlurIn(layer, radius: blur, duration: 0.36, delay: delay)
+    }
+}
