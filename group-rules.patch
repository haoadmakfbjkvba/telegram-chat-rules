diff --git a/submodules/TelegramUI/Sources/ChatInterfaceStateInputPanels.swift b/submodules/TelegramUI/Sources/ChatInterfaceStateInputPanels.swift
index de61248449..ba45572bf7 100644
--- a/submodules/TelegramUI/Sources/ChatInterfaceStateInputPanels.swift
+++ b/submodules/TelegramUI/Sources/ChatInterfaceStateInputPanels.swift
@@ -143,6 +143,21 @@ func inputPanelForChatPresentationIntefaceState(_ chatPresentationInterfaceState
         }
     }
     
+    // A group whose rules are to be accepted first: the bar asking for it, in place of the message field (or of Join).
+    if chatPresentationInterfaceState.interfaceState.editMessage == nil, let chatController = interfaceInteraction?.chatController() as? ChatControllerImpl, let prompt = chatController.groupRulesPrompt {
+        if let currentPanel = (currentPanel as? GroupRulesInputPanelNode) ?? (currentSecondaryPanel as? GroupRulesInputPanelNode) {
