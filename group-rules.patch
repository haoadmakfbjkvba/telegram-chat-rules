diff --git a/submodules/TelegramUI/Components/GroupRules/Sources/GroupRules.swift b/submodules/TelegramUI/Components/GroupRules/Sources/GroupRules.swift
new file mode 100644
index 0000000000..de547f5967
--- /dev/null
+++ b/submodules/TelegramUI/Components/GroupRules/Sources/GroupRules.swift
@@ -0,0 +1,192 @@
+import Foundation
+import SwiftSignalKit
+import TelegramCore
+
+/// A group's rules, set by its admins. They are kept at the end of the group's description, so that no server change is
+/// needed and any Telegram app shows them (as part of the description):
+///
+///     Weekend hikes around the city 🥾
+///
+///     📜 Rules ✅
+///     1. Be kind to each other
+///     2. No ads or self-promotion
+///
+/// The ✅ after "Rules" asks new members to accept them before they can write. This app hides the block from the
+/// description and shows the rules on their own.
+public struct GroupRules: Equatable {
+    public static let symbol = "📜"
+    public static let acceptanceMark = "✅"
+    public static let maxRules = 10
+    public static let maxRuleLength = 80
+    /// How long a group's description can be, as `length(of:)` counts it.
+    public static let maxDescriptionLength = 255
+
+    public var rules: [String]
+    /// Whether new members have to accept the rules before they can write.
+    public var requiresAcceptance: Bool
+
+    public init(rules: [String], requiresAcceptance: Bool) {
+        self.rules = rules
+        self.requiresAcceptance = requiresAcceptance
+    }
+
+    /// A short fingerprint of the rules (an accepted set is asked for again when they change).
+    public var fingerprint: String {
+        var hash: UInt64 = 0xcbf29ce484222325
+        for byte in self.rules.joined(separator: "\n").utf8 {
+            hash = (hash ^ UInt64(byte)) &* 0x100000001b3
+        }
+        return String(hash, radix: 36)
+    }
+
+    // MARK: - The block in the description
+
+    /// How the rules are written into the description (`header` is the localized word for "Rules").
+    public func block(header: String) -> String {
+        var lines = ["\(GroupRules.symbol) \(header)" + (self.requiresAcceptance ? " \(GroupRules.acceptanceMark)" : "")]
+        for (index, rule) in self.rules.enumerated() {
+            lines.append("\(index + 1). \(rule)")
+        }
+        return lines.joined(separator: "\n")
+    }
+
+    /// The description without its rules block, and the rules the block describes.
+    public static func split(about: String?) -> (text: String, rules: GroupRules?) {
+        guard let about, let parsed = GroupRules.parse(about: about) else {
+            return (about ?? "", nil)
+        }
+        return (parsed.text, parsed.rules)
+    }
+
+    /// The word the block of this description is headed with ("Rules", in the language it was written in), if it has one.
+    public static func header(about: String?) -> String? {
+        guard let about else {
+            return nil
+        }
+        return GroupRules.parse(about: about)?.header
+    }
+
+    /// The block is the last line beginning with the symbol that has numbered rules right after it ("1. Rule", "1) Rule"
+    /// or without the space; blank lines between them are fine). Anything after the rules (added by another app, say) is
+    /// part of the description.
+    private static func parse(about: String) -> (text: String, rules: GroupRules, header: String?)? {
+        let lines = about.components(separatedBy: "\n")
+        for headerIndex in lines.indices.reversed() {
+            let headerLine = lines[headerIndex].trimmingCharacters(in: .whitespaces)
+            guard headerLine.hasPrefix(GroupRules.symbol) else {
+                continue
+            }
+            var rules: [String] = []
+            var endIndex = headerIndex + 1
+            var index = headerIndex + 1
+            while index < lines.count {
+                let trimmed = lines[index].trimmingCharacters(in: .whitespaces)
+                if trimmed.isEmpty {
+                    index += 1
+                    continue
+                }
+                guard let range = trimmed.range(of: "^[0-9]{1,2}[.)]\\s*", options: .regularExpression) else {
+                    break
+                }
+                let rule = String(trimmed[range.upperBound...]).trimmingCharacters(in: .whitespaces)
+                if !rule.isEmpty {
+                    rules.append(rule)
+                }
+                index += 1
+                endIndex = index
+            }
+            guard !rules.isEmpty else {
+                continue
+            }
+            let before = lines[..<headerIndex].joined(separator: "\n").trimmingCharacters(in: .whitespacesAndNewlines)
+            let after = lines[endIndex...].joined(separator: "\n").trimmingCharacters(in: .whitespacesAndNewlines)
+            let text = [before, after].filter { !$0.isEmpty }.joined(separator: "\n\n")
+            var header = String(headerLine.dropFirst(GroupRules.symbol.count))
+            header = header.replacingOccurrences(of: GroupRules.acceptanceMark, with: "").trimmingCharacters(in: .whitespaces)
+            return (text, GroupRules(rules: rules, requiresAcceptance: headerLine.contains(GroupRules.acceptanceMark)), header.isEmpty ? nil : header)
+        }
+        return nil
+    }
+
+    /// The description `text` (without a block of its own) with the block of `rules` after it (or without one).
+    public static func about(text: String, rules: GroupRules?, header: String) -> String {
+        let text = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard let rules, !rules.rules.isEmpty else {
+            return text
+        }
+        let block = rules.block(header: header)
+        return text.isEmpty ? block : text + "\n\n" + block
+    }
+
+    /// The length of a description as the server counts it (UTF-16 units, the larger count).
+    public static func length(of about: String) -> Int {
+        return about.utf16.count
+    }
+}
+
+/// Which groups' rules the account has accepted, and where the prompt to accept is showing. Kept on the device, per
+/// account. Safe from any thread; changes are told through `updated`.
+public final class GroupRulesStore {
+    public static let shared = GroupRulesStore()
+
+    private let lock = NSLock()
+    private var promptingKeys = Set<String>()
+    private let updatedPipe = ValuePipe<EnginePeer.Id>()
+
+    /// The group whose acceptance or prompt changed.
+    public var updated: Signal<EnginePeer.Id, NoError> {
+        return self.updatedPipe.signal()
+    }
+
+    private static func key(accountPeerId: EnginePeer.Id, peerId: EnginePeer.Id) -> String {
+        return "GroupRules.Accepted.\(accountPeerId.toInt64()).\(peerId.toInt64())"
+    }
+
+    private static func promptingKey(accountPeerId: EnginePeer.Id, peerId: EnginePeer.Id) -> String {
+        return "\(accountPeerId.toInt64()).\(peerId.toInt64())"
+    }
+
+    /// Whether the account has accepted these very rules of the group.
+    public func hasAccepted(_ rules: GroupRules, peerId: EnginePeer.Id, accountPeerId: EnginePeer.Id) -> Bool {
+        return UserDefaults.standard.string(forKey: GroupRulesStore.key(accountPeerId: accountPeerId, peerId: peerId)) == rules.fingerprint
+    }
+
+    public func accept(_ rules: GroupRules, peerId: EnginePeer.Id, accountPeerId: EnginePeer.Id) {
+        UserDefaults.standard.set(rules.fingerprint, forKey: GroupRulesStore.key(accountPeerId: accountPeerId, peerId: peerId))
+        self.lock.lock()
+        self.promptingKeys.remove(GroupRulesStore.promptingKey(accountPeerId: accountPeerId, peerId: peerId))
+        self.lock.unlock()
+        self.updatedPipe.putNext(peerId)
+    }
+
+    /// Whether the bar asking to accept the rules replaces the Join button of the group (after the rules were closed
+    /// without accepting them). Only while the app runs.
+    public func isPrompting(_ peerId: EnginePeer.Id, accountPeerId: EnginePeer.Id) -> Bool {
+        self.lock.lock()
+        defer {
+            self.lock.unlock()
+        }
+        return self.promptingKeys.contains(GroupRulesStore.promptingKey(accountPeerId: accountPeerId, peerId: peerId))
+    }
+
+    public func setPrompting(_ peerId: EnginePeer.Id, accountPeerId: EnginePeer.Id, _ value: Bool) {
+        let key = GroupRulesStore.promptingKey(accountPeerId: accountPeerId, peerId: peerId)
+        self.lock.lock()
+        let changed: Bool
+        if value {
+            changed = self.promptingKeys.insert(key).inserted
+        } else {
+            changed = self.promptingKeys.remove(key) != nil
+        }
+        self.lock.unlock()
+        if changed {
+            self.updatedPipe.putNext(peerId)
+        }
+    }
+}
+
+/// A chat that shows a group's rules before Join goes through.
+public protocol GroupRulesGate: AnyObject {
+    /// Called by Join: true if the rules are shown first (and `join` is called once they are accepted).
+    func groupRulesBeforeJoin(join: @escaping () -> Void) -> Bool
+}
diff --git a/submodules/TelegramUI/Components/GroupRules/Sources/GroupRulesIconView.swift b/submodules/TelegramUI/Components/GroupRules/Sources/GroupRulesIconView.swift
new file mode 100644
index 0000000000..8b69386225
--- /dev/null
+++ b/submodules/TelegramUI/Components/GroupRules/Sources/GroupRulesIconView.swift
@@ -0,0 +1,218 @@
+import Foundation
+import UIKit
+import Display
+
+public enum GroupRulesColors {
+    /// The warm amber of the rules (a scroll in candlelight).
+    public static let top = UIColor(rgb: 0xFFB340)
+    public static let bottom = UIColor(rgb: 0xFF7A1A)
+    /// The seal once they are accepted.
+    public static let seal = UIColor(rgb: 0x34C759)
+}
+
+/// The rules' icon: an amber tile with a scroll on it. It can unroll (the paper opens between its two rollers and its
+/// lines write themselves) and be sealed (a green seal with a check stamps onto its corner).
+public final class GroupRulesIconView: UIView {
+    private let tile = CAGradientLayer()
+    private let canvas = CALayer()
+    private let paper = CAShapeLayer()
+    private let topRoller = CAShapeLayer()
+    private let bottomRoller = CAShapeLayer()
+    private var lines: [CAShapeLayer] = []
+    private let seal = CAShapeLayer()
+    private let sealCheck = CAShapeLayer()
+
+    /// A small icon (in a list row) draws only the scroll in white, without the tile.
+    public var isSmall = false {
+        didSet {
+            self.tile.isHidden = self.isSmall
+            self.setNeedsLayout()
+        }
+    }
+
+    override public init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isUserInteractionEnabled = false
+        self.tile.colors = [GroupRulesColors.top.cgColor, GroupRulesColors.bottom.cgColor]
+        self.tile.startPoint = CGPoint(x: 0.2, y: 0.0)
+        self.tile.endPoint = CGPoint(x: 0.8, y: 1.0)
+        self.layer.addSublayer(self.tile)
+        self.layer.addSublayer(self.canvas)
+        self.canvas.addSublayer(self.paper)
+        for _ in 0 ..< 3 {
+            let line = CAShapeLayer()
+            line.lineCap = .round
+            line.fillColor = UIColor.clear.cgColor
+            self.lines.append(line)
+            self.canvas.addSublayer(line)
+        }
+        self.canvas.addSublayer(self.topRoller)
+        self.canvas.addSublayer(self.bottomRoller)
+        self.seal.fillColor = GroupRulesColors.seal.cgColor
+        self.seal.strokeColor = UIColor.white.cgColor
+        self.seal.opacity = 0.0
+        self.layer.addSublayer(self.seal)
+        self.sealCheck.fillColor = UIColor.clear.cgColor
+        self.sealCheck.strokeColor = UIColor.white.cgColor
+        self.sealCheck.lineCap = .round
+        self.sealCheck.lineJoin = .round
+        self.seal.addSublayer(self.sealCheck)
+        self.applyColors()
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    private func applyColors() {
+        let color = UIColor.white
+        self.paper.fillColor = UIColor.clear.cgColor
+        self.paper.strokeColor = color.cgColor
+        for roller in [self.topRoller, self.bottomRoller] {
+            roller.fillColor = color.cgColor
+        }
+        for line in self.lines {
+            line.strokeColor = color.cgColor
+        }
+    }
+
+    override public func layoutSubviews() {
+        super.layoutSubviews()
+        let bounds = self.bounds
+        let side = min(bounds.width, bounds.height)
+        // Drawn at the screen's resolution of what is shown, twice over (it grows larger than itself as it comes in).
+        let contentsScale = UIScreenScale * 2.0
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.tile.frame = bounds
+        self.tile.cornerRadius = side * 0.29
+        if #available(iOS 13.0, *) {
+            self.tile.cornerCurve = .continuous
+        }
+        self.canvas.frame = bounds
+        let glyph = self.isSmall ? bounds.insetBy(dx: side * 0.08, dy: side * 0.06) : bounds.insetBy(dx: side * 0.27, dy: side * 0.22)
+        let lineWidth = max(1.6, glyph.width * 0.1)
+        // The paper, between two rollers.
+        let paperRect = CGRect(x: glyph.minX + glyph.width * 0.08, y: glyph.minY + lineWidth * 1.2, width: glyph.width * 0.84, height: glyph.height - lineWidth * 2.4)
+        self.paper.frame = bounds
+        self.paper.path = UIBezierPath(roundedRect: paperRect, cornerRadius: lineWidth * 0.6).cgPath
+        self.paper.lineWidth = lineWidth
+        let rollerHeight = lineWidth * 1.9
+        self.topRoller.frame = bounds
+        self.topRoller.path = UIBezierPath(roundedRect: CGRect(x: glyph.minX, y: glyph.minY, width: glyph.width, height: rollerHeight), cornerRadius: rollerHeight * 0.5).cgPath
+        self.bottomRoller.frame = bounds
+        self.bottomRoller.path = UIBezierPath(roundedRect: CGRect(x: glyph.minX, y: glyph.maxY - rollerHeight, width: glyph.width, height: rollerHeight), cornerRadius: rollerHeight * 0.5).cgPath
+        // Three lines of writing on the paper, the last shorter.
+        let inset = paperRect.width * 0.2
+        for (index, line) in self.lines.enumerated() {
+            let y = paperRect.minY + paperRect.height * (0.3 + CGFloat(index) * 0.2)
+            let endX = paperRect.maxX - inset - (index == 2 ? paperRect.width * 0.22 : 0.0)
+            let path = UIBezierPath()
+            path.move(to: CGPoint(x: paperRect.minX + inset, y: y))
+            path.addLine(to: CGPoint(x: endX, y: y))
+            line.frame = bounds
+            line.path = path.cgPath
+            line.lineWidth = lineWidth * 0.75
+        }
+        // The seal on the lower right corner, partly over the tile's edge.
+        let sealSide = side * 0.44
+        self.seal.frame = CGRect(x: bounds.maxX - sealSide * 0.82, y: bounds.maxY - sealSide * 0.82, width: sealSide, height: sealSide)
+        self.seal.path = UIBezierPath(ovalIn: CGRect(origin: CGPoint(), size: CGSize(width: sealSide, height: sealSide))).cgPath
+        self.seal.lineWidth = max(2.0, sealSide * 0.08)
+        let check = UIBezierPath()
+        check.move(to: CGPoint(x: sealSide * 0.28, y: sealSide * 0.52))
+        check.addLine(to: CGPoint(x: sealSide * 0.44, y: sealSide * 0.67))
+        check.addLine(to: CGPoint(x: sealSide * 0.72, y: sealSide * 0.36))
+        self.sealCheck.frame = CGRect(origin: CGPoint(), size: CGSize(width: sealSide, height: sealSide))
+        self.sealCheck.path = check.cgPath
+        self.sealCheck.lineWidth = max(2.0, sealSide * 0.11)
+        for layer in [self.tile, self.canvas, self.paper, self.topRoller, self.bottomRoller, self.seal, self.sealCheck] + self.lines {
+            layer.contentsScale = contentsScale
+        }
+        CATransaction.commit()
+    }
+
+    /// The tile pops up turning, the scroll unrolls (the rollers part, the paper opens between them) and its lines write
+    /// themselves one after another. Returns how long it takes.
+    @discardableResult
+    public func animateUnroll(delay: Double) -> Double {
+        guard !UIAccessibility.isReduceMotionEnabled else {
+            return 0.0
+        }
+        if !self.isSmall {
+            rulesAddKeyframes(self.layer, keyPath: "transform.scale", values: [0.0, 1.22, 0.92, 1.05, 1.0], keyTimes: [0.0, 0.38, 0.62, 0.82, 1.0], duration: 0.75, delay: delay)
+            rulesAddKeyframes(self.layer, keyPath: "transform.rotation.z", values: [-0.7, 0.14, -0.05, 0.0], keyTimes: [0.0, 0.42, 0.72, 1.0], duration: 0.75, delay: delay)
+        }
+        let open = delay + 0.25
+        let half = self.bounds.height * 0.18
+        rulesAddKeyframes(self.topRoller, keyPath: "transform.translation.y", values: [half, -2.0, 0.0], keyTimes: [0.0, 0.7, 1.0], duration: 0.5, delay: open, timing: .easeOut)
+        rulesAddKeyframes(self.bottomRoller, keyPath: "transform.translation.y", values: [-half, 2.0, 0.0], keyTimes: [0.0, 0.7, 1.0], duration: 0.5, delay: open, timing: .easeOut)
+        rulesAddKeyframes(self.paper, keyPath: "transform.scale.y", values: [0.06, 1.04, 1.0], keyTimes: [0.0, 0.7, 1.0], duration: 0.5, delay: open, timing: .easeOut)
+        for (index, line) in self.lines.enumerated() {
+            rulesAddKeyframes(line, keyPath: "strokeEnd", values: [0.0, 1.0], keyTimes: [0.0, 1.0], duration: 0.22, delay: open + 0.42 + Double(index) * 0.16, timing: .easeInEaseOut)
+        }
+        return open + 0.42 + 0.16 * 2.0 + 0.22 - delay
+    }
+
+    /// Whether the seal is on the corner (shown as it is, without stamping it).
+    public var isSealed: Bool {
+        get {
+            return self.seal.opacity > 0.5
+        }
+        set {
+            CATransaction.begin()
+            CATransaction.setDisableActions(true)
+            // Animations held at their end would hide the new state.
+            self.seal.removeAllAnimations()
+            self.sealCheck.removeAllAnimations()
+            self.seal.opacity = newValue ? 1.0 : 0.0
+            self.sealCheck.strokeEnd = 1.0
+            CATransaction.commit()
+        }
+    }
+
+    /// The seal lifts off the corner: it grows a little and fades, turning away.
+    public func liftSeal() {
+        guard self.isSealed else {
+            return
+        }
+        self.isSealed = false
+        guard !UIAccessibility.isReduceMotionEnabled else {
+            return
+        }
+        rulesAddKeyframes(self.seal, keyPath: "opacity", values: [1.0, 1.0, 0.0], keyTimes: [0.0, 0.3, 1.0], duration: 0.32, delay: 0.0, timing: .easeIn)
+        rulesAddKeyframes(self.seal, keyPath: "transform.scale", values: [1.0, 1.12, 1.5], keyTimes: [0.0, 0.3, 1.0], duration: 0.32, delay: 0.0, timing: .easeIn)
