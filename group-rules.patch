+    /// A group's description as edited, with its rules kept at the end (they are edited on their own). A block of rules
+    /// typed into the field itself is taken as the rules.
+    func groupRulesUpdatedAbout(description: String, currentAbout: String?) -> String? {
+        let (currentText, currentRules) = GroupRules.split(about: currentAbout)
+        if description == currentText {
+            return currentAbout
+        }
+        if GroupRules.split(about: description).rules != nil {
+            return description
+        }
+        return GroupRules.about(text: description, rules: currentRules, header: GroupRules.header(about: currentAbout) ?? self.presentationData.strings.GroupRules_Header)
+    }
+
+    /// The description and the rules after it do not fit: the field shakes and says why.
+    func groupRulesDescriptionTooLong(over: Int) {
+        self.hapticFeedback.error()
+        self.headerNode.editingContentNode.shakeTextForKey(.description)
+        self.controller?.present(textAlertController(context: self.context, title: nil, text: self.presentationData.strings.GroupRules_TooLong("\(over)").string, actions: [TextAlertAction(type: .defaultAction, title: self.presentationData.strings.Common_OK, action: {})]), in: .window(.root))
+    }
+
+    /// The group's rules, for its admins (kept at the end of its description).
+    private func editingOpenGroupRules() {
+        guard let data = self.data, let peer = data.peer else {
+            return
+        }
+        var about: String?
+        if let cachedData = data.cachedData as? CachedChannelData {
+            about = cachedData.about
+        } else if let cachedData = data.cachedData as? CachedGroupData {
+            about = cachedData.about
+        }
+        self.view.endEditing(true)
+        self.controller?.push(GroupRulesEditorScreen(context: self.context, peerId: peer.id, groupTitle: peer.compactDisplayTitle, about: about))
+    }
